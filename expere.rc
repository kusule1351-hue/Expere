#include <windows.h>
#include <commctrl.h>
#include "resource.h"

1 RT_MANIFEST "expere.manifest"

IDD_SETTINGS DIALOGEX 0, 0, 276, 304
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "Expere Settings"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "Shortcut", -1, 8, 6, 260, 48
    LTEXT           "Open Expere with", -1, 16, 22, 76, 8
    PUSHBUTTON      "", IDC_HOTKEYBOX, 96, 18, 164, 16, WS_TABSTOP
    LTEXT           "", IDC_HOTKEYHINT, 96, 38, 168, 8

    GROUPBOX        "Appearance", -1, 8, 60, 260, 72
    LTEXT           "Theme", -1, 16, 76, 76, 8
    COMBOBOX        IDC_THEME, 96, 73, 164, 80, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "Background", -1, 16, 94, 76, 8
    COMBOBOX        IDC_BACKDROP, 96, 91, 164, 80, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "Opacity", -1, 16, 113, 76, 8
    CONTROL         "", IDC_OPACITY, "msctls_trackbar32", TBS_HORZ | TBS_NOTICKS | WS_TABSTOP, 92, 110, 140, 14
    LTEXT           "", IDC_OPACITY_VAL, 236, 113, 26, 8

    GROUPBOX        "Search", -1, 8, 138, 260, 70
    LTEXT           "Visible rows", -1, 16, 154, 76, 8
    COMBOBOX        IDC_MAXRESULTS, 96, 151, 60, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Web search", -1, 16, 172, 76, 8
    COMBOBOX        IDC_ENGINE, 96, 169, 164, 80, CBS_DROPDOWNLIST | WS_TABSTOP
    AUTOCHECKBOX    "Include files and folders", IDC_FILES, 16, 189, 200, 10, WS_TABSTOP

    GROUPBOX        "General", -1, 8, 214, 260, 66
    AUTOCHECKBOX    "Start with Windows", IDC_STARTUP, 16, 228, 200, 10, WS_TABSTOP
    AUTOCHECKBOX    "Keep the last search when reopening", IDC_KEEPQUERY, 16, 242, 200, 10, WS_TABSTOP
    PUSHBUTTON      "Clear usage history", IDC_CLEARHIST, 16, 258, 84, 14, WS_TABSTOP

    DEFPUSHBUTTON   "OK", IDOK, 112, 284, 50, 14, WS_TABSTOP
    PUSHBUTTON      "Cancel", IDCANCEL, 166, 284, 50, 14, WS_TABSTOP
    PUSHBUTTON      "Apply", IDC_APPLY, 220, 284, 48, 14, WS_TABSTOP
END
